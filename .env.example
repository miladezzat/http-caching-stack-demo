# Copy to .env at the repository root. Never commit real credentials.
PORT=3000
API_HOST=127.0.0.1
API_BASE_URL=http://127.0.0.1:3000
WEB_PORT=4000
# Choose a long random token; enter it into the demo's admin form.
ADMIN_TOKEN=local-demo-admin-token-change-me
# Local embedded PostgreSQL. One API process owns this directory.
DATA_DIR=.data/postgres
# Optional: use external PostgreSQL instead of DATA_DIR.
# DATABASE_URL=postgresql://demo:demo@127.0.0.1:5432/caching_demo
CDN_MODE=simulated
ALLOW_DEMO_FAILURES=true
PURGE_POLL_MS=1000
LIST_EDGE_TTL=60
DETAIL_EDGE_TTL=300
# For live Cloudflare, set CDN_MODE=cloudflare and supply both values.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
